# Optional: configure this only after deploying a secured server endpoint.
# For the Vercel api/answer.js function, use /api/answer.
VITE_NYAYAI_AI_ENDPOINT=/api/answer

# Server-side Vercel environment variables (set in the hosting dashboard; never in this file):
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-5.2
# NYAYAI_ALLOWED_ORIGIN=https://your-deployed-app.example
